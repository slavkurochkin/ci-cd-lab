# Copy to terraform.tfvars and set github_repo. That file is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

github_repo     = "your-github-username/ci-cd-lab"

# Numeric IDs, because GitHub embeds them in the sub claim. Find yours with:
#   gh api repos/OWNER/NAME --jq "\"repo \(.id), owner \(.owner.id)\""
github_owner_id = "0"
github_repo_id  = "0"

# Optional -- these are the defaults.
# region    = "us-east-1"
# role_name = "ci-cd-lab-ci"
