# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
coverage/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# Never commit variable files -- they routinely hold account IDs and secrets.
*.auto.tfvars
terraform.tfvars
# Except the environments' inputs (Capstone B): an environment name, a
# retention period and an image digest. Committing them is how a deploy is
# reviewed. Nothing secret or account-specific belongs in them.
!infra/envs/*/terraform.tfvars
# The state bucket's name contains the account ID. See infra/backend.hcl.example.
infra/backend.hcl
# Local-backend overrides, used before Project 7 creates the state bucket.
*_override.tf

# Local environment
.env
.env.local
kubeconfig

# macOS
.DS_Store

# Terraform-generated artifacts from infra/sandbox
infra/sandbox/generated/
